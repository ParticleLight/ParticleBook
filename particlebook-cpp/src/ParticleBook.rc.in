#include <windows.h>

// Application icon
#define IDI_MAIN_ICON 101
IDI_MAIN_ICON ICON "..\\assets\\app.ico"

// Version info — generated by CMake from project(VERSION ...)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "ParticleLight"
            VALUE "FileDescription",  "ParticleBook - Z-Library E-Book Reader"
            VALUE "FileVersion",      "@PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0"
            VALUE "InternalName",     "ParticleBook"
            VALUE "LegalCopyright",   "Copyright 2026 ParticleLight"
            VALUE "OriginalFilename", "ParticleBook.exe"
            VALUE "ProductName",      "ParticleBook"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
